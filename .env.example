HEPHAESTUS_CONFIG_DIR=./config
# Required single-user login credentials. The password is intentionally stored
# as plaintext in this local .env file; restrict its filesystem permissions.
# See SECURITY.md for why, and for what that does and does not protect.
HEPHAESTUS_AUTH_USERNAME=
HEPHAESTUS_AUTH_PASSWORD=
# Required HS256 signing secret. Generate at least 32 random bytes and do not
# reuse the login password.
HEPHAESTUS_JWT_SECRET=
# Explicit database selection: SQLite is convenient for a local single-user install.
# Replace with a PostgreSQL DSN/URL for a long-lived deployment, for example:
# HEPHAESTUS_DATABASE_URL='host=localhost user=postgres password=postgres dbname=hephaestus port=5432 sslmode=disable'
HEPHAESTUS_DATABASE_URL=sqlite://./data/hephaestus.db
HEPHAESTUS_DEEPSEEK_API_KEY=
# Optional OpenAI-compatible endpoint. Identities whose preferred_model is
# advertised by this endpoint are routed to it instead of DeepSeek.
HEPHAESTUS_LOCAL_MODEL_URL=
HEPHAESTUS_LOCAL_MODEL_API_KEY=
# Optional QQ Bot channel. AppID and AppSecret must be set together. Leave the
# open ID empty on the first run: the bot then replies to any sender with their
# own open ID and processes nothing, so you can copy it back into this file.
HEPHAESTUS_QQ_APP_ID=
HEPHAESTUS_QQ_APP_SECRET=
HEPHAESTUS_QQ_USER_OPENID=
# An image-only channel message waits this long for an accompanying text message.
HEPHAESTUS_CHANNEL_IMAGE_TEXT_WAIT_SECONDS=30
# Upload policy. Text files within HEPHAESTUS_UPLOAD_INLINE_TEXT_MAX_BYTES are
# included in the prompt. JPEG, PNG, GIF, and WebP files are sent to the vision model.
HEPHAESTUS_UPLOAD_TEXT_EXTENSIONS=md,markdown,txt,csv,json,yaml,yml,toml,xml
HEPHAESTUS_UPLOAD_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
HEPHAESTUS_UPLOAD_INLINE_TEXT_MAX_BYTES=10240
HEPHAESTUS_UPLOAD_FILE_MAX_BYTES=52428800
HEPHAESTUS_UPLOAD_TOTAL_MAX_BYTES=262144000
HEPHAESTUS_UPLOAD_MAX_FILES=5
# Runaway-output guard. A model that degenerates into repeating the same text
# never sends finish_reason, so max_tokens does not stop it; the guard detects
# the repetition mid-stream, aborts the request, and drops the repeated tail so
# it is not persisted or replayed as context on the next turn. Defaults shown;
# set GUARD_DISABLED=true to turn it off entirely.
HEPHAESTUS_LLM_REPETITION_GUARD_DISABLED=false
HEPHAESTUS_LLM_REPETITION_MAX_CHAR_RUN=1024
HEPHAESTUS_LLM_REPETITION_WINDOW_BYTES=4096
HEPHAESTUS_LLM_REPETITION_MIN_BYTES=4096
HEPHAESTUS_LLM_REPETITION_RATIO_PERCENT=3.9
HEPHAESTUS_LLM_MAX_CHANNEL_BYTES=8388608
# Backstop: every streamed delta becomes a chat_run_events row, so cap the
# total payload one run may persist. The LLM guard should always fire first.
HEPHAESTUS_CHATRUN_MAX_EVENT_BYTES=16777216
HEPHAESTUS_WECOM_WEBHOOK_URL=
# Keep the authenticated API reachable only through the local host or SSH forwarding.
# A non-loopback deployment must terminate HTTPS before reaching Hephaestus.
HEPHAESTUS_LISTEN_ADDR=127.0.0.1:9016
# Set to true when HTTPS is terminated in front of Hephaestus, so the session
# cookie is issued with the Secure attribute. Leave false for plain loopback use.
HEPHAESTUS_COOKIE_SECURE=false
# Required context for the environment and metaphysics plugins.
HEPHAESTUS_ENV_LOCATION=
HEPHAESTUS_ENV_LATITUDE=
HEPHAESTUS_ENV_LONGITUDE=
HEPHAESTUS_ENV_TIMEZONE=Asia/Shanghai
# Tried in order; public providers require no credentials.
HEPHAESTUS_WEATHER_PROVIDERS=open_meteo,wttr,met_no
HEPHAESTUS_FIXED_PLUGINS=environment,metaphysics,session_summary
# Maximum recursive spawn/fork delegation depth.
HEPHAESTUS_SUBAGENT_MAX_DEPTH=2
# Project directories are created below this root. A leading ~/ is expanded.
HEPHAESTUS_PROJECTS_ROOT=./data/projects
# High-risk override: allow file tools and exec working_directory to use any path.
# When false, the bound Project and the system temporary directory remain accessible.
HEPHAESTUS_PROJECT_ACCESS_OVERRIDE=false
# exec tool: set to "true" to allow running commands in bound Projects.
# It is a convenience for a single trusted user, NOT a security boundary.
HEPHAESTUS_SHELL_ENABLED=false
# Execution target: local (default) or ssh. SSH uses the system OpenSSH
# client and therefore honors ~/.ssh/config, ssh-agent, known_hosts, and
# ProxyJump. The remote Project directory is <root>/<project-name> and must
# already exist; Project files are not automatically synchronized.
HEPHAESTUS_SHELL_BACKEND=local
HEPHAESTUS_SHELL_SSH_DESTINATION=
HEPHAESTUS_SHELL_SSH_PROJECTS_ROOT=
# web_fetch uses Firecrawl by default and falls back to a local headless browser.
# A Firecrawl key is required unless HEPHAESTUS_WEB_FETCH_PROVIDER=local.
HEPHAESTUS_WEB_FETCH_PROVIDER=firecrawl
HEPHAESTUS_FIRECRAWL_API_KEY=
# Optional path to Chrome/Chromium for the local fetch provider. Leave empty
# to auto-detect the browser installed on this host.
HEPHAESTUS_WEB_FETCH_CHROME_PATH=
# Fetched page text is capped at HEPHAESTUS_WEB_FETCH_MAX_CHARS; when an LLM
# is available, content over HEPHAESTUS_WEB_FETCH_SUMMARY_MAX_CHARS is condensed
# to a digest within that cap before it reaches the agent.
HEPHAESTUS_WEB_FETCH_MAX_CHARS=64000
HEPHAESTUS_WEB_FETCH_SUMMARY_MAX_CHARS=4000
# web_search always queries DuckDuckGo and Sogou concurrently.
# Brave/Tavily are optional; when both are configured one is chosen per search.
HEPHAESTUS_WEB_SEARCH_BRAVE_API_KEYS=
HEPHAESTUS_WEB_SEARCH_TAVILY_API_KEYS=
# SerpAPI/SearXNG are optional and have a combined 20% chance of being queried.
HEPHAESTUS_WEB_SEARCH_SERPAPI_API_KEYS=
# Defaults to UK-localized Google Light Search; set to bing for Bing Search.
HEPHAESTUS_WEB_SEARCH_SERPAPI_ENGINE=google_light
HEPHAESTUS_WEB_SEARCH_SEARXNG_BASE_URL=
# Result lists over this cap are LLM-condensed (URLs preserved) before reaching the agent.
HEPHAESTUS_WEB_SEARCH_SUMMARY_MAX_CHARS=4000
# Optional outbound proxy used by `make deploy` when generating the PM2
# environment. Nothing is injected when it is empty.
HEPHAESTUS_PROXY_URL=
HEPHAESTUS_NO_PROXY=127.0.0.1,localhost
# Set to 1 to run live network tests, including web search and local Chrome fetch.
HEPHAESTUS_RUN_LIVE_TESTS=
