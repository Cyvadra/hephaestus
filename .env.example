HEPHAESTUS_CONFIG_DIR=./config
HEPHAESTUS_POSTGRES_DSN=host=localhost user=postgres password=postgres dbname=hephaestus port=5432 sslmode=disable
HEPHAESTUS_DEEPSEEK_API_KEY=
HEPHAESTUS_WECOM_WEBHOOK_URL=
HEPHAESTUS_LISTEN_ADDR=:9016
HEPHAESTUS_FIXED_PLUGINS=session_summary
# Project directories are created below this root. A leading ~/ is expanded.
HEPHAESTUS_PROJECTS_ROOT=~/Documents/hephaestus-projects
# High-risk override: allow file tools and exec working_directory to use any path.
# When false, the bound Project and the system temporary directory remain accessible.
HEPHAESTUS_PROJECT_ACCESS_OVERRIDE=false
# exec tool: set to "true" to allow running commands in bound Projects.
# It is a convenience for a single trusted user, NOT a security boundary.
HEPHAESTUS_SHELL_ENABLED=false
# web_fetch uses Firecrawl by default and falls back to a local headless browser.
# A Firecrawl key is required unless HEPHAESTUS_WEB_FETCH_PROVIDER=local.
HEPHAESTUS_WEB_FETCH_PROVIDER=firecrawl
HEPHAESTUS_FIRECRAWL_API_KEY=
# Optional path to Chrome/Chromium. This host provides Google Chrome here.
HEPHAESTUS_WEB_FETCH_CHROME_PATH=/usr/bin/google-chrome
# Fetched page text is capped at HEPHAESTUS_WEB_FETCH_MAX_CHARS; when an LLM
# is available, content over HEPHAESTUS_WEB_FETCH_SUMMARY_MAX_CHARS is condensed
# to a digest within that cap before it reaches the agent.
HEPHAESTUS_WEB_FETCH_MAX_CHARS=64000
HEPHAESTUS_WEB_FETCH_SUMMARY_MAX_CHARS=4000
# web_search always queries DuckDuckGo and Sogou concurrently.
# Brave/Tavily are optional; when both are configured one is chosen per search.
HEPHAESTUS_WEB_SEARCH_BRAVE_API_KEYS=
HEPHAESTUS_WEB_SEARCH_TAVILY_API_KEYS=
# SerpAPI/SearXNG are optional and have a combined 20% chance of being queried.
HEPHAESTUS_WEB_SEARCH_SERPAPI_API_KEYS=
# Defaults to UK-localized Google Light Search; set to bing for Bing Search.
HEPHAESTUS_WEB_SEARCH_SERPAPI_ENGINE=google_light
HEPHAESTUS_WEB_SEARCH_SEARXNG_BASE_URL=
# Result lists over this cap are LLM-condensed (URLs preserved) before reaching the agent.
HEPHAESTUS_WEB_SEARCH_SUMMARY_MAX_CHARS=4000
# Set to 1 to run live network tests, including web search and local Chrome fetch.
HEPHAESTUS_RUN_LIVE_TESTS=
